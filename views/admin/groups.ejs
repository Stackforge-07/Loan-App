<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
  <div class="dashboard-layout">
    <% const activePage = 'groups'; %>
    <%- include('../partials/sidebar-admin') %>
    <main class="dashboard-main">
      <% const pageTitle = 'Groups'; %>
      <%- include('../partials/dashboard-header') %>
      <div class="dashboard-content">
        <!-- Create Group -->
        <div class="card">
          <div class="card-header"><h2 class="card-title">Create New Group</h2></div>
          <form action="/admin/groups" method="POST" class="form-vertical">
            <div class="form-row">
              <div class="form-group"><label for="name">Group Name *</label><input type="text" id="name" name="name" placeholder="e.g., Shakti SHG" required></div>
              <div class="form-group"><label for="location">Location</label><input type="text" id="location" name="location" placeholder="Village / District"></div>
            </div>
            <div class="form-group"><label for="description">Description</label><textarea id="description" name="description" rows="2" placeholder="Brief description of the group"></textarea></div>
            <button type="submit" class="btn btn-primary btn-sm">Create Group</button>
          </form>
        </div>

        <!-- Groups List -->
        <div class="card">
          <div class="card-header"><h2 class="card-title">All Groups</h2></div>
          <% if (groups.length > 0) { %>
            <div class="table-responsive">
              <table class="table">
                <thead><tr><th>Group ID</th><th>Name</th><th>Leader</th><th>Members</th><th>Total Savings</th><th>Location</th><th>Actions</th></tr></thead>
                <tbody>
                  <% groups.forEach(g => { %>
                  <tr>
                    <td><span class="badge badge-default"><%= g.groupId %></span></td>
                    <td><strong><%= g.name %></strong></td>
                    <td><%= g.leaderId ? g.leaderId.name : '—' %></td>
                    <td><%= g.memberCount %></td>
                    <td>₹<%= g.totalSavings.toLocaleString('en-IN') %></td>
                    <td><%= g.location || '—' %></td>
                    <td><a href="/admin/groups/<%= g._id %>" class="btn btn-outline btn-xs">View</a></td>
                  </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="empty-state">
              <p>No groups created yet.</p><span>Create your first self-help group above.</span>
            </div>
          <% } %>
        </div>
      </div>
    </main>
  </div>
  <script src="/js/main.js"></script>
</body>
</html>
