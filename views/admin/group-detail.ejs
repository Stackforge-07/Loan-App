<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
  <div class="dashboard-layout">
    <% const activePage = 'groups'; %>
    <%- include('../partials/sidebar-admin') %>
    <main class="dashboard-main">
      <% const pageTitle = group.name; %>
      <%- include('../partials/dashboard-header') %>
      <div class="dashboard-content">
        <a href="/admin/groups" class="btn btn-outline btn-sm" style="margin-bottom: 1.5rem;">← Back to Groups</a>

        <!-- Group Info -->
        <div class="card">
          <div class="card-header">
            <h2 class="card-title">Group Details</h2>
            <span class="badge badge-default"><%= group.groupId %></span>
          </div>
          <form action="/admin/groups/<%= group._id %>/edit" method="POST" class="form-vertical">
            <div class="detail-grid">
              <div class="detail-item">
                <span class="detail-label">Group ID</span>
                <span class="detail-value"><%= group.groupId %></span>
              </div>
              <div class="detail-item">
                <span class="detail-label">Leader</span>
                <span class="detail-value"><%= group.leaderId ? group.leaderId.name : '—' %></span>
              </div>
              <div class="detail-item">
                <span class="detail-label">Total Members</span>
                <span class="detail-value"><%= memberCount %></span>
              </div>
              <div class="detail-item">
                <span class="detail-label">Total Savings</span>
                <span class="detail-value">₹<%= totalSavings.toLocaleString('en-IN') %></span>
              </div>
              <div class="detail-item">
                <span class="detail-label">Created</span>
                <span class="detail-value"><%= new Date(group.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' }) %></span>
              </div>
            </div>
            <div class="form-row" style="margin-top: 1.5rem;">
              <div class="form-group">
                <label for="name">Group Name</label>
                <input type="text" id="name" name="name" value="<%= group.name %>" required>
              </div>
              <div class="form-group">
                <label for="location">Location</label>
                <input type="text" id="location" name="location" value="<%= group.location || '' %>">
              </div>
            </div>
            <div class="form-group">
              <label for="description">Description</label>
              <textarea id="description" name="description" rows="2"><%= group.description || '' %></textarea>
            </div>
            <button type="submit" class="btn btn-primary btn-sm">Update Group</button>
          </form>
        </div>

        <!-- Members -->
        <div class="card">
          <div class="card-header">
            <h2 class="card-title">Members (<%= memberCount %>)</h2>
          </div>
          <% if (members.length > 0) { %>
            <div class="table-responsive">
              <table class="table">
                <thead>
                  <tr><th>Name</th><th>Email</th><th>Phone</th><th>Status</th><th>Joined</th><th>Actions</th></tr>
                </thead>
                <tbody>
                  <% members.forEach(m => { %>
                  <tr>
                    <td><strong><%= m.name %></strong></td>
                    <td><%= m.email %></td>
                    <td><%= m.phone %></td>
                    <td><span class="badge badge-<%= m.status === 'active' ? 'success' : 'error' %>"><%= m.status %></span></td>
                    <td><%= new Date(m.joinDate).toLocaleDateString('en-IN') %></td>
                    <td>
                      <a href="/admin/members/<%= m._id %>" class="btn btn-outline btn-xs">View</a>
                    </td>
                  </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="empty-state">
              <p>No members in this group yet.</p>
              <span>Members will appear here once they register and join.</span>
            </div>
          <% } %>
        </div>
      </div>
    </main>
  </div>
  <script src="/js/main.js"></script>
</body>
</html>
