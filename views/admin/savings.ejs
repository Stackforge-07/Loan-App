<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
  <div class="dashboard-layout">
    <% const activePage = 'savings'; %>
    <%- include('../partials/sidebar-admin') %>
    <main class="dashboard-main">
      <% const pageTitle = 'Savings Management'; %>
      <%- include('../partials/dashboard-header') %>
      <div class="dashboard-content">
        <!-- Group Savings Summary -->
        <div class="stat-grid stat-grid-2">
          <div class="stat-card stat-card-green">
            <div class="stat-card-content">
              <p class="stat-card-label">Group Total Savings</p>
              <h3 class="stat-card-value">₹<%= groupTotalSavings.toLocaleString('en-IN') %></h3>
            </div>
          </div>
          <div class="stat-card stat-card-blue">
            <div class="stat-card-content">
              <p class="stat-card-label">Active Members</p>
              <h3 class="stat-card-value"><%= members.length %></h3>
            </div>
          </div>
        </div>

        <!-- Record Savings -->
        <div class="card">
          <div class="card-header">
            <h2 class="card-title">Record Savings Contribution</h2>
          </div>
          <form action="/admin/savings" method="POST" class="form-vertical">
            <div class="form-row">
              <div class="form-group">
                <label for="memberId">Select Member *</label>
                <select id="memberId" name="memberId" required>
                  <option value="">-- Select Member --</option>
                  <% members.forEach(m => { %>
                    <option value="<%= m._id %>"><%= m.name %> (<%= m.email %>)</option>
                  <% }); %>
                </select>
              </div>
              <div class="form-group">
                <label for="amount">Amount (₹) *</label>
                <input type="number" id="amount" name="amount" min="1" step="1" placeholder="e.g., 500" required>
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label for="month">Month *</label>
                <select id="month" name="month" required>
                  <option value="">-- Select Month --</option>
                  <% ['January','February','March','April','May','June','July','August','September','October','November','December'].forEach(m => { %>
                    <option value="<%= m %>"><%= m %></option>
                  <% }); %>
                </select>
              </div>
              <div class="form-group">
                <label for="year">Year *</label>
                <input type="number" id="year" name="year" min="2020" max="2100" value="<%= new Date().getFullYear() %>" required>
              </div>
              <div class="form-group">
                <label for="date">Date</label>
                <input type="date" id="date" name="date" value="<%= new Date().toISOString().split('T')[0] %>">
              </div>
            </div>
            <button type="submit" class="btn btn-primary">Record Contribution</button>
          </form>
        </div>

        <!-- Filter -->
        <div class="card">
          <div class="card-header">
            <h2 class="card-title">Savings History</h2>
          </div>
          <form action="/admin/savings" method="GET" class="filter-form" style="margin-bottom: 1rem;">
            <div class="filter-row">
              <select name="memberId">
                <option value="">All Members</option>
                <% members.forEach(m => { %>
                  <option value="<%= m._id %>" <%= filterMemberId === String(m._id) ? 'selected' : '' %>><%= m.name %></option>
                <% }); %>
              </select>
              <select name="month">
                <option value="">All Months</option>
                <% ['January','February','March','April','May','June','July','August','September','October','November','December'].forEach(m => { %>
                  <option value="<%= m %>" <%= filterMonth === m ? 'selected' : '' %>><%= m %></option>
                <% }); %>
              </select>
              <input type="number" name="year" placeholder="Year" value="<%= filterYear %>" min="2020" max="2100">
              <button type="submit" class="btn btn-primary btn-sm">Filter</button>
              <a href="/admin/savings" class="btn btn-outline btn-sm">Clear</a>
            </div>
          </form>

          <% if (savings.length > 0) { %>
            <div class="table-responsive">
              <table class="table">
                <thead>
                  <tr><th>Date</th><th>Member</th><th>Month</th><th>Year</th><th>Amount</th><th>Balance</th><th>Recorded By</th></tr>
                </thead>
                <tbody>
                  <% savings.forEach(s => { %>
                  <tr>
                    <td><%= new Date(s.date).toLocaleDateString('en-IN') %></td>
                    <td><strong><%= s.memberId ? s.memberId.name : '—' %></strong></td>
                    <td><%= s.month %></td>
                    <td><%= s.year %></td>
                    <td class="text-success">₹<%= s.amount.toLocaleString('en-IN') %></td>
                    <td>₹<%= s.runningBalance.toLocaleString('en-IN') %></td>
                    <td><%= s.recordedBy ? s.recordedBy.name : '—' %></td>
                  </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="empty-state">
              <p>No savings records found.</p>
              <span>Use the form above to record savings contributions.</span>
            </div>
          <% } %>
        </div>
      </div>
    </main>
  </div>
  <script src="/js/main.js"></script>
</body>
</html>
