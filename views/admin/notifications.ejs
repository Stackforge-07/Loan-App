<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
  <div class="dashboard-layout">
    <% const activePage = 'notifications'; %>
    <%- include('../partials/sidebar-admin') %>
    <main class="dashboard-main">
      <% const pageTitle = 'Notifications'; %>
      <%- include('../partials/dashboard-header') %>
      <div class="dashboard-content">
        <div class="card">
          <div class="card-header">
            <h2 class="card-title">All Notifications</h2>
            <% if (notifications.some(n => !n.isRead)) { %>
              <form action="/notifications/mark-all-read" method="POST" style="margin: 0;">
                <button type="submit" class="btn btn-outline btn-sm">Mark All as Read</button>
              </form>
            <% } %>
          </div>
          <% if (notifications.length > 0) { %>
            <div class="notification-list">
              <% notifications.forEach(n => { %>
              <div class="notification-item <%= n.isRead ? '' : 'unread' %>">
                <div class="notification-dot notification-dot-<%= n.type %>"></div>
                <div class="notification-content">
                  <p class="notification-title"><%= n.title %></p>
                  <p class="notification-message"><%= n.message %></p>
                  <span class="notification-time"><%= new Date(n.createdAt).toLocaleDateString('en-IN', {day:'numeric',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'}) %></span>
                </div>
                <% if (n.link) { %><a href="<%= n.link %>" class="btn btn-outline btn-sm">View</a><% } %>
              </div>
              <% }); %>
            </div>
          <% } else { %>
            <div class="empty-state">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
              <p>No notifications.</p>
            </div>
          <% } %>
        </div>
      </div>
    </main>
  </div>
  <script src="/js/main.js"></script>
</body>
</html>
