<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
  <div class="dashboard-layout">
    <% const activePage = 'loans'; %>
    <%- include('../partials/sidebar-member') %>
    <main class="dashboard-main">
      <% const pageTitle = 'Loan Details'; %>
      <%- include('../partials/dashboard-header') %>
      <div class="dashboard-content">
        <a href="/member/loans" class="btn btn-outline btn-sm" style="margin-bottom: 1.5rem;">← Back to Loans</a>

        <!-- Loan Summary -->
        <div class="card">
          <div class="card-header">
            <h2 class="card-title">Loan <%= loan.loanId %></h2>
            <span class="badge badge-<%= loan.status === 'completed' ? 'success' : loan.status === 'rejected' ? 'error' : loan.status === 'active' || loan.status === 'partially_paid' ? 'warning' : 'info' %>">
              <%= loan.status.replace(/_/g, ' ') %>
            </span>
          </div>
          <div class="detail-grid">
            <div class="detail-item">
              <span class="detail-label">Principal Amount</span>
              <span class="detail-value">₹<%= loan.principalAmount.toLocaleString('en-IN') %></span>
            </div>
            <div class="detail-item">
              <span class="detail-label">Interest Rate</span>
              <span class="detail-value"><%= loan.interestRate %>% p.a.</span>
            </div>
            <div class="detail-item">
              <span class="detail-label">Tenure</span>
              <span class="detail-value"><%= loan.tenure %> months</span>
            </div>
            <div class="detail-item">
              <span class="detail-label">Total Payable</span>
              <span class="detail-value">₹<%= loan.totalPayable.toLocaleString('en-IN') %></span>
            </div>
            <div class="detail-item">
              <span class="detail-label">Amount Paid</span>
              <span class="detail-value text-success">₹<%= loan.amountPaid.toLocaleString('en-IN') %></span>
            </div>
            <div class="detail-item">
              <span class="detail-label">Outstanding Balance</span>
              <span class="detail-value text-warning">₹<%= loan.outstandingBalance.toLocaleString('en-IN') %></span>
            </div>
            <div class="detail-item">
              <span class="detail-label">Purpose</span>
              <span class="detail-value"><%= loan.purpose.charAt(0).toUpperCase() + loan.purpose.slice(1) %></span>
            </div>
            <div class="detail-item">
              <span class="detail-label">Requested</span>
              <span class="detail-value"><%= new Date(loan.requestedAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' }) %></span>
            </div>
          </div>
          <% if (['active','partially_paid','disbursed'].includes(loan.status)) { %>
          <div class="loan-progress" style="margin-top: 1.5rem;">
            <div class="loan-progress-bar">
              <div class="loan-progress-fill" style="width: <%= loan.totalPayable > 0 ? Math.round((loan.amountPaid / loan.totalPayable) * 100) : 0 %>%"></div>
            </div>
            <div class="loan-progress-labels">
              <span><%= loan.totalPayable > 0 ? Math.round((loan.amountPaid / loan.totalPayable) * 100) : 0 %>% repaid</span>
            </div>
          </div>
          <% } %>
          <% if (loan.interestRate > 0) { %>
          <div class="interest-disclaimer">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
            <span>Interest is calculated using simple interest formula for academic purposes. This is not professional financial advice.</span>
          </div>
          <% } %>
        </div>

        <!-- Installment Schedule -->
        <div class="card">
          <div class="card-header">
            <h2 class="card-title">Installment Schedule</h2>
            <% if (installments.length > 0) { %>
              <span class="text-muted"><%= installments.filter(i => i.status === 'paid').length %> of <%= installments.length %> paid</span>
            <% } %>
          </div>
          <% if (installments.length > 0) { %>
            <div class="table-responsive">
              <table class="table">
                <thead>
                  <tr>
                    <th>#</th>
                    <th>Due Date</th>
                    <th>Amount</th>
                    <th>Paid</th>
                    <th>Status</th>
                    <th>Paid On</th>
                  </tr>
                </thead>
                <tbody>
                  <% installments.forEach(inst => { %>
                  <tr class="<%= inst.status === 'overdue' ? 'row-overdue' : '' %>">
                    <td><%= inst.installmentNumber %></td>
                    <td><%= new Date(inst.dueDate).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></td>
                    <td>₹<%= inst.amount.toLocaleString('en-IN') %></td>
                    <td>₹<%= inst.paidAmount.toLocaleString('en-IN') %></td>
                    <td>
                      <span class="badge badge-<%= inst.status === 'paid' ? 'success' : inst.status === 'overdue' ? 'error' : inst.status === 'partially_paid' ? 'warning' : 'default' %>">
                        <%= inst.status.replace(/_/g, ' ') %>
                      </span>
                    </td>
                    <td><%= inst.paidAt ? new Date(inst.paidAt).toLocaleDateString('en-IN') : '—' %></td>
                  </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="empty-state">
              <p>No installment schedule generated yet.</p>
              <span>An installment schedule will be created once your loan is disbursed.</span>
            </div>
          <% } %>
        </div>

        <!-- Repayment History -->
        <div class="card">
          <div class="card-header">
            <h2 class="card-title">Repayment History</h2>
          </div>
          <% if (repayments.length > 0) { %>
            <div class="table-responsive">
              <table class="table">
                <thead>
                  <tr>
                    <th>Date</th>
                    <th>Amount</th>
                    <th>Method</th>
                    <th>Notes</th>
                  </tr>
                </thead>
                <tbody>
                  <% repayments.forEach(r => { %>
                  <tr>
                    <td><%= new Date(r.paymentDate).toLocaleDateString('en-IN') %></td>
                    <td class="text-success">₹<%= r.amount.toLocaleString('en-IN') %></td>
                    <td><%= r.paymentMethod.replace(/_/g, ' ') %></td>
                    <td><%= r.notes || '—' %></td>
                  </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="empty-state">
              <p>No repayments recorded yet.</p>
            </div>
          <% } %>
        </div>
      </div>
    </main>
  </div>
  <script src="/js/main.js"></script>
</body>
</html>
