<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
  <div class="dashboard-layout">
    <% const activePage = 'loans'; %>
    <%- include('../partials/sidebar-member') %>
    <main class="dashboard-main">
      <% const pageTitle = 'My Loans'; %>
      <%- include('../partials/dashboard-header') %>
      <div class="dashboard-content">
        <div class="card-header-actions">
          <h2>Loan History</h2>
          <a href="/member/loans/request" class="btn btn-primary btn-sm">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
            Request Loan
          </a>
        </div>

        <% if (loans.length > 0) { %>
          <div class="loans-grid">
            <% loans.forEach(loan => { %>
            <div class="card loan-card">
              <div class="loan-card-header">
                <span class="loan-id"><%= loan.loanId %></span>
                <span class="badge badge-<%= loan.status === 'completed' ? 'success' : loan.status === 'rejected' ? 'error' : loan.status === 'active' || loan.status === 'partially_paid' ? 'warning' : 'info' %>">
                  <%= loan.status.replace(/_/g, ' ') %>
                </span>
              </div>
              <div class="loan-card-body">
                <div class="loan-detail-row">
                  <span>Principal</span>
                  <strong>₹<%= loan.principalAmount.toLocaleString('en-IN') %></strong>
                </div>
                <div class="loan-detail-row">
                  <span>Total Payable</span>
                  <strong>₹<%= loan.totalPayable.toLocaleString('en-IN') %></strong>
                </div>
                <% if (loan.interestRate > 0) { %>
                <div class="loan-detail-row">
                  <span>Interest Rate</span>
                  <strong><%= loan.interestRate %>% p.a.</strong>
                </div>
                <% } %>
                <div class="loan-detail-row">
                  <span>Purpose</span>
                  <strong><%= loan.purpose.charAt(0).toUpperCase() + loan.purpose.slice(1) %></strong>
                </div>
                <div class="loan-detail-row">
                  <span>Tenure</span>
                  <strong><%= loan.tenure %> months</strong>
                </div>
                <% if (['active','partially_paid','disbursed'].includes(loan.status)) { %>
                <div class="loan-progress">
                  <div class="loan-progress-bar">
                    <div class="loan-progress-fill" style="width: <%= loan.totalPayable > 0 ? Math.round((loan.amountPaid / loan.totalPayable) * 100) : 0 %>%"></div>
                  </div>
                  <div class="loan-progress-labels">
                    <span>Paid: ₹<%= loan.amountPaid.toLocaleString('en-IN') %></span>
                    <span>Remaining: ₹<%= loan.outstandingBalance.toLocaleString('en-IN') %></span>
                  </div>
                </div>
                <% } %>
                <% if (loan.status === 'rejected' && loan.rejectionReason) { %>
                <div class="loan-rejection">
                  <strong>Reason:</strong> <%= loan.rejectionReason %>
                </div>
                <% } %>
              </div>
              <div class="loan-card-footer">
                <a href="/member/loans/<%= loan._id %>" class="btn btn-outline btn-sm btn-full">View Details</a>
              </div>
            </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="card">
            <div class="empty-state">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
              <p>No active loans.</p>
              <span>You can request a loan from your group fund.</span>
              <a href="/member/loans/request" class="btn btn-primary btn-sm" style="margin-top: 1rem;">Request Loan</a>
            </div>
          </div>
        <% } %>
      </div>
    </main>
  </div>
  <script src="/js/main.js"></script>
</body>
</html>
